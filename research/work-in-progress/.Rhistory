plotcite == "Ahrsjo (2023)" ~ "Ahrsjo et al. (2023)",
plotcite == "Britto (2022)" ~ "Britto et al. (2022)",
plotcite == "Clemente-Casinhas (2024)" ~ "Clemente-Casinhas et al. (2024)",
plotcite == "Del Pozo (2024)" ~ "Del Pozo et al. (2024)",
plotcite == "Deutscher (2019)" ~ "Deutscher and Mazumder (2019)",
plotcite == "Elk (2024)" ~ "Elk et al. (2024)",
plotcite == "Fan (2015)" ~ "Fan et al. (2015)",
plotcite == "Kaila (2024)" ~ "Kaila et al. (2024)",
plotcite == "Kenedi (2023)" ~ "Kenedi and Sirugue (2023)",
plotcite == "Chu (2020)" ~ "Chu and Lin (2020)",
plotcite == "ELIK¸SAH (2023)" ~ "Eliksah et al. (2023)",
plotcite == "leites (2022)" ~ "Leites et al. (2022)",
.default = plotcite))
data <- index %>%
# Drop Chile 2009 which is not comparable because it has more circumstances
filter(!(c == "CHL" & y == 2009)) %>%
select(name, c, iso, y, latest, var) %>%
na.omit() %>%
mutate(y = as.numeric(y)) %>%
filter(latest == 1) %>%
select(name, c, iso, y, var) %>%
mutate(name = ifelse(name == "Czech Rep.", "Czech Republic", name)) %>%
full_join(mobility, by = "name")%>%
mutate(iso = case_when(name == "Canada" ~ "CAN",
name == "Russia" ~ "RUS",
name == "Taiwan" ~ "TWN",
name == "Turkey" ~ "TUR",
name == "Uruguay" ~ "URY",
.default = iso)) %>%
select(iso, mobility, plotcite, source) %>%
na.omit()
stops <- data.frame(
q = 0:9 / 9,
c = viridis(10, direction = -1, option = "G"),
stringsAsFactors = FALSE
)
stops <- list_parse2(stops)
highchart(type = "map") %>%
hc_add_series_map(
map = map_data,
df = data,
joinBy = c("iso-a3", "iso"),
value = "mobility",
name = "Intergenerational persistence",
borderColor = "#FAFAFA",
borderWidth = 0.1,
tooltip = list(
pointFormat = "<b>{point.name}: {point.value}</b><br>Source: {point.plotcite} [{point.source}]",
valueDecimals = 2
)
) %>%
hc_colorAxis(stops = stops,
min = min(data$mobility, na.rm = T),
max = max(data$mobility, na.rm = T)) %>%
hc_mapView(
projection = list(
name = "ESRI:53030"
)
)
