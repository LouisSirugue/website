inc_dt <- baseline_dt %>%
filter(indicator %chin% c("IGE", "Rank-rank"))  %>%
separate(age_children, c("age_min", "age_max"), "-") %>%
mutate(age_max = ifelse(is.na(age_max), age_min, age_max)) %>%
mutate(age_avg = (as.numeric(age_min) + as.numeric(age_max))/2) %>%
separate(year, c("year_min", "year_max"), "-") %>%
mutate(year_max = ifelse(is.na(year_max), year_min, year_max)) %>%
mutate(year_avg = (as.numeric(year_min) + as.numeric(year_max))/2) %>%
mutate(cohort_avg = ifelse(is.na(cohort_avg), year_avg - age_avg, cohort_avg)) %>%
mutate(method = ifelse(method == "OLS", "Observed", "Predicted"),
order_method = as.numeric(method == "Observed"))
set.seed(1)
inc_dt2 <- inc_dt %>%
filter(cohort_avg > 1970 & age_avg >= 25 & age_avg <= 40)
# In this subset, favor TSLS over OLS
inc_dt3 <- inc_dt2 %>%
group_by(indicator, country) %>%
mutate(has_ols = max(method == "Observed")) %>%
ungroup() %>%
filter(!(has_ols == 1 & method == "Predicted"))
# favor most comprehensive parents income definition available
inc_dt4 <- inc_dt3 %>%
filter(!((country  == "BRA" & indicator == "IGE" & var_description == "Only fathers") |
(country  == "URY" & indicator == "Rank-rank" & var_description == "Earnings. Measures averaged across 5 years.") |
(country  == "CHL" & indicator == "Rank-rank" & data_source1 == "Admin data on wages in the public sector and education") |
(country  == "URY" & indicator == "IGE" & data_source1 == "ENAJ") |
(country  == "URY" & indicator == "IGE" & grepl("Mothers", var_description))))
my_maps <- rbind(shp %>% mutate(indicator = "Rank-rank correlation"),
shp %>% mutate(indicator = "Intergenerational elasticity"),
shp %>% mutate(indicator = "Regression coefficient"))%>%
left_join(inc_dt4 %>%
select(indicator, country, estimate) %>%
rbind(baseline_dt %>%
filter(short_ref == "Neidhöfer et al. (2018)" & data_source1 == "Latinobarometro" & cohort == "1980-1983") %>%
select(indicator, country, estimate)) %>%
mutate(indicator = case_when(indicator == "Rank-rank" ~ "Rank-rank correlation",
indicator == "IGE" ~ "Intergenerational elasticity",
indicator == "Regression coefficient" ~ "Regression coefficient")),
by = c("country", "indicator")) %>%
mutate(order_i = case_when(indicator == "Rank-rank correlation" ~ 3,
indicator == "Intergenerational elasticity" ~ 2,
indicator == "Regression coefficient" ~ 1)) %>%
ggplot(aes(fill = estimate)) +
geom_sf()  +
facet_wrap(~reorder(indicator, order_i), nrow = 1) +
scale_fill_viridis_c("Coefficient:", na.value = "transparent", option = 2) +
theme_void() +
guides(fill = guide_colorbar(barwidth = 20, barheight = 0.5))+
theme(strip.text = element_blank(),
legend.position = "bottom",
legend.direction = "horizontal",
legend.title = element_text(size = 10, vjust= 1),
axis.line = element_line(color = alpha("black", .2)))
my_scatter <- baseline_dt %>%
filter(indicator %chin% c("Rank-rank", "IGE", "Regression coefficient")) %>%
mutate(indicator = case_when(indicator == "Rank-rank" ~ "Rank-rank correlation",
indicator == "IGE" ~ "Intergenerational elasticity",
indicator == "Regression coefficient" ~ "Regression coefficient"),
label = ifelse(label == "Dominican Republic", "Dom. Rep.", label)) %>%
mutate(order_i = case_when(indicator == "Rank-rank correlation" ~ 3,
indicator == "Intergenerational elasticity" ~ 2,
indicator == "Regression coefficient" ~ 1),
method = ifelse(method == "OLS", "Observed", "Predicted"),
method = ifelse(indicator == "Regression coefficient", NA, method),
order_method = as.numeric(method == "Observed")) %>%
mutate(indicator = case_when(indicator == "Rank-rank correlation" ~ "Rank-rank\ncorrelation in income",
indicator == "Intergenerational elasticity" ~ "Intergenerational\nincome elasticity",
indicator == "Regression coefficient" ~ "Education\nregression coefficient")) %>%
arrange(label) %>%
mutate(order_label = row_number()) %>%
mutate(order_label = min(order_label), .by = label) %>%
ggplot(aes(x = estimate, y = reorder(label, order_label, decreasing = T), color = method)) +
geom_point(alpha = .6) +
facet_wrap(~reorder(indicator, order_i), nrow = 1) +
scale_color_manual("Parents' income:",
breaks = c("Observed", "Predicted"),
values = viridis(2, begin = .2, end = .75, option = 2)) +
scale_x_continuous("Coefficient", breaks = seq(0, 1.4, .2)) +
theme(axis.title = element_blank(),
legend.position = "top",
legend.direction = "horizontal",
legend.title = element_text(size = 10, vjust= .5),
axis.text.y = element_markdown(size = 8.5))
my_scatter / my_maps
ggsave("../work-in-progress/brunori_et_al_2025/out/full_set_v2.png", width = bwidth, height = bheight)
