library(tidyverse) # Version 2.0.0  ~ For basic data wrangling
library(readxl)    # Version 1.4.3  ~ To open Excel files
library(sf)        # Version 1.0.15 ~ To handle shapefiles and plot maps
library(highcharter) #For interactive plot
library(viridisLite)
# World map
map_data <- readRDS("sirugue_2026/src/world_map.rds")
# GEOM results
index <- read_excel("sirugue_2026/src/index.xlsx")
shortlist <- read.csv("sirugue_2026/src/shortlist.csv") %>%
rbind(read.csv("sirugue_2026/src/shortlist_supplement.csv")) %>%
select(paperId, citex)
mobility <- read.csv("sirugue_2026/src/world_view.csv") %>%
filter(estimator == "IRA") %>%
mutate(country = ifelse(country == "United States", "United States of America", country)) %>%
select(name = country, paperId, mobility = estimate, source) %>%
left_join(shortlist,  by = "paperId") %>%
mutate(handle = gsub(",.*$", "", citex),
handle = gsub("^.*\\{", "", handle),
cite = paste0("[@", handle, "1]"),
plotcite = paste0(gsub("[^0-9]*$", "", handle)),
plotcite = paste0(substr(plotcite, 1, nchar(plotcite) - 4), " (",
substr(plotcite, nchar(plotcite) - 3, nchar(plotcite)), ")"),
handle = gsub(",.*$", "", citex),
cite = ifelse(grepl("2023OnlineAF", cite), "[@ELIKSAH2023OnlineAF1]", cite),
cite = ifelse(cite == "[@Greenaway‐McGrevy2024TemporalAR1]", "[@GreenawayMcGrevy2024TemporalAR1]", cite)) %>%
mutate(plotcite = ifelse(plotcite == "daza (2021)", "Daza Baez (2021)", plotcite),
plotcite = ifelse(plotcite == "()", "Eriksen (2020)", plotcite),
plotcite = ifelse(plotcite == "delpozo (2024)", "Del Pozo (2024)", plotcite))
data <- index %>%
# Drop Chile 2009 which is not comparable because it has more circumstances
filter(!(c == "CHL" & y == 2009)) %>%
select(name, c, iso, y, latest, var) %>%
na.omit() %>%
mutate(y = as.numeric(y)) %>%
filter(latest == 1) %>%
select(name, c, iso, y, var) %>%
mutate(name = ifelse(name == "Czech Rep.", "Czech Republic", name)) %>%
left_join(mobility, by = "name")
View(data)
